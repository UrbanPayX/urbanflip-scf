{
  "name": "distribution-engine",
  "version": "0.1.0",
  "description": "Pro-rata distribution engine for Stellar (SCF #45 D3): computes per-investor schedules from the loan ledger, emits SDP-ready payment files, checks trustlines, replays historical payouts exactly.",
