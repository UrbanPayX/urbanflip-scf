{
  "name": "gated-issuance",
  "version": "0.1.0",
  "description": "Generic compliance-gated asset issuance layer for Stellar (SCF #45 D1). The issuance core depends only on a ComplianceGate port; Urbanflip's KYC pipeline is one pluggable adapter.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:live": "RUN_LIVE=1 vitest run test/live-testnet-lifecycle.test.ts",
    "demo": "tsx demo/live-lifecycle.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.3.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
