{
  "name": "wallet-onboarding",
  "version": "0.1.0",
  "description": "Invisible-crypto wallet onboarding for Stellar (SCF #45 D2): embedded/external wallets, CAP-33 sponsored reserves, 100% fee-bumped investor transactions. Investors never hold XLM.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:live": "RUN_LIVE=1 vitest run test/live-testnet-sponsorship.test.ts",
    "demo": "tsx demo/live-onboarding.ts",
    "build:web": "node web/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.3.0"
  },
  "devDependencies": {
    "@creit.tech/stellar-wallets-kit": "2.7.1",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
